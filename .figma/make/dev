#!/usr/bin/env bash
# Start the HMS3 Corporate New Business app (redesigned root build).
# The UI is a static, dependency-free SPA served straight from the repo root
# (index.html + assets/). No bundler, no build step, no backend required.
set -e
cd "$(dirname "$0")/../.."
PORT="${PORT:-4180}"
exec python3 -m http.server "$PORT" --bind 127.0.0.1
