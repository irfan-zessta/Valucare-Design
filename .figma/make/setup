#!/usr/bin/env bash
# First-open setup for the React + @carbon/react app (lives in web/).
# Confirms the Node toolchain is available; dependencies are installed by install.
set -e
command -v node >/dev/null 2>&1 || {
  echo "node is required but was not found on PATH" >&2
  exit 1
}
command -v npm >/dev/null 2>&1 || {
  echo "npm is required but was not found on PATH" >&2
  exit 1
}
echo "node $(node --version), npm $(npm --version)"
